# ──────────────────────────────────────────────────────────────────────────────
# REGENOVA-Intel environment configuration
# Copy this file to .env and fill in EVERY value marked  ← REQUIRED or ← PROD
# Never commit .env to version control.
# See docs/PRODUCTION_RUNBOOK.md for the fastest path to going live.
# ──────────────────────────────────────────────────────────────────────────────

# LLM  ← REQUIRED
LLM_API_KEY=sk-...
LLM_BASE_URL=
# Backward compatibility: if LLM_API_KEY is unset, OPENAI_API_KEY is used.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1

# Vector DB
VECTOR_DB_BACKEND=chroma   # chroma | weaviate | pinecone
CHROMA_PERSIST_DIR=./data/chroma_db
WEAVIATE_URL=http://localhost:8080
PINECONE_API_KEY=
PINECONE_ENV=

# Graph DB (only needed when ENABLE_GRAPH_RETRIEVAL=true)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme   # ← PROD: replace with a strong password (min 16 chars)

# App
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development   # ← PROD: set to "production"

# Auth / role gating  ← PROD: BOTH values MUST be changed before going live
# Generate strong values with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
ADMIN_API_KEY=admin-dev-key

# Data paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CURATED_DATA_DIR=./data/curated

# Audit
AUDIT_DB_PATH=./data/audit.db
# ← PROD: replace with a random secret (used for HMAC-SHA256 IP hashing)
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_IP_SALT=change-this-to-a-random-secret-in-production

# Task queue (arq / Redis)
# When REDIS_URL is set, autonomous ingestion runs on a durable Redis-backed
# queue processed by a separate worker (run: `make run-worker`). When empty,
# work runs in-process via BackgroundTasks (dev only — not durable).
REDIS_URL=
ARQ_JOB_TIMEOUT=3600

# Prescriber frontend static directory
FRONTEND_DIR=./apps/frontend

# API docs (interactive Swagger UI / ReDoc)
# Set to false in production unless you deliberately want the API explorer public.
ENABLE_DOCS=true   # ← PROD: set to false

# PubMed
PUBMED_EMAIL=your@email.com
PUBMED_API_KEY=

# YouTube
YOUTUBE_API_KEY=

# YouTube transcript proxy (to bypass YouTube's datacenter-IP block).
# PREFERRED: Webshare rotating residential proxies. Set username/password from
# your Webshare dashboard (residential product). Pass only the BASE username
# (strip any "-N" suffix); the library appends rotation logic.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Optional: constrain residential pool to ISO country codes (comma-separated).
# WEBSHARE_PROXY_LOCATIONS=us,gb
# Optional: retries when YouTube blocks a request (default 10).
# WEBSHARE_PROXY_RETRIES=10
#
# LEGACY/DEMO fallback: single generic proxy URL (SSH-tunnelled tinyproxy).
# Used only when the Webshare vars above are unset.
# YT_TRANSCRIPT_PROXY=http://host.docker.internal:8888

# YouTube transcript fetch throttling (avoids the burst pattern that trips
# YouTube's rate limiter on channel-level ingest). A randomised delay of
# base + uniform(0, jitter) seconds is inserted BETWEEN fetches (not before
# the first, not after the last). On a failed fetch, an exponential backoff
# (5s -> 10s -> 20s ... capped 60s) is added and reset on the next success.
# Set both to 0 to disable inter-request throttling (backoff still applies).
YT_FETCH_DELAY_SECONDS=2.0
YT_FETCH_JITTER_SECONDS=1.5

# Feature flags
ENABLE_GRAPH_RETRIEVAL=false
ENABLE_RECONSTITUTION_GUIDANCE=false

# CORS — list your production frontend origins here (comma-separated JSON array)
# Example: CORS_ORIGINS=["https://app.yourdomain.com"]
# Default (dev): localhost origins only
# CORS_ORIGINS=["https://app.yourdomain.com"]
